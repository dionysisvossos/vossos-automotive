# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vossos?schema=public"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Αρχικός admin (seed) — προαιρετικά, αλλιώς admin@vossos.local / admin1234
ADMIN_EMAIL="admin@vossos.local"
ADMIN_PASSWORD="change-me"

# S3-compatible object storage (έγγραφα υποθέσεων)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET="vossos-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
