# Αντίγραψέ το σε .env και συμπλήρωσε τις τιμές:  cp .env.example .env
# (το docker compose διαβάζει αυτόματα το .env)

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=vossos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vossos

# ── Εφαρμογή ────────────────────────────────────────────────
# Μυστικό για το Auth.js — δημιούργησέ το με:  openssl rand -base64 32
AUTH_SECRET=

# Θύρα στο host (η εφαρμογή ακούει εσωτερικά στο 3000)
APP_PORT=3000

# ── Αρχικός admin (μόνο στην 1η εκκίνηση, όσο η βάση είναι άδεια) ─
# Άλλαξε τον κωδικό μετά την πρώτη σύνδεση.
ADMIN_EMAIL=admin@vossos.local
ADMIN_PASSWORD=change-me

# (προαιρετικό) Σταθερό δημόσιο URL πίσω από proxy/domain:
# AUTH_URL=https://ypotheseis.example.gr

# ── Τοπική ανάπτυξη (χωρίς Docker) ──────────────────────────
# Για `npm run dev` εκτός Docker, όρισε επιπλέον:
# DATABASE_URL=postgresql://vossos:vossos_dev@localhost:5432/vossos?schema=public
